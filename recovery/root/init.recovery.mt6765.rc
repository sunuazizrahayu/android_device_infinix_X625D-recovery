# init.recovery.mt6765.rc - USB configfs untuk X625D (diambil dari stock recovery.img)
# Fix ADB OrangeFox: stock cuma start adbd saat ro.debuggable=0,
# di Fox (eng, debuggable=1) adbd tidak ke-start -> tambah trigger debuggable=1
# Fix MTP: stock cuma buat ffs.adb -> TWRP log "could not open MTP driver, errno: 2".
# TWRP R11 MtpServer pakai transport functionfs (ffs.mtp, /dev/usb-ffs/mtp,
# ditandai sys.usb.ffs.mtp.ready=1), BUKAN legacy mtp.gs0 (/dev/mtp_usb).
# Kalau yang di-link mtp.gs0, PC melihat interface MTP tapi tidak ada yang
# menjawab -> USB reset berulang, mtp-detect "failed to open session".
# Jadi yang di-link sebagai mtp_adb: ffs.adb + ffs.mtp.
# TW_EXCLUDE_DEFAULT_USB_INIT=true, jadi file ini yang pegang gadget, jangan dimatikan.

on init
    mkdir /config
    mount configfs none /config
    mkdir /config/usb_gadget/g1 0770 shell shell
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee2
    mkdir /config/usb_gadget/g1/strings/0x409 0770
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer ${ro.product.manufacturer}
    write /config/usb_gadget/g1/strings/0x409/product ${ro.product.model}
    mkdir /config/usb_gadget/g1/configs/b.1 0777 shell shell
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 shell shell
    mkdir /config/usb_gadget/g1/functions/ffs.adb
    mkdir /config/usb_gadget/g1/functions/mtp.gs0
    mkdir /config/usb_gadget/g1/functions/ffs.mtp
    mkdir /dev/usb-ffs 0770 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000
    mkdir /dev/usb-ffs/mtp 0770 shell shell
    mount functionfs mtp /dev/usb-ffs/mtp uid=2000,gid=2000
    setprop sys.usb.ffs.aio_compat 1
    setprop sys.usb.config mtp,adb

on property:ro.debuggable=0
    write /sys/class/udc/musb-hdrc/device/cmode 2
    start adbd

on property:ro.debuggable=1
    write /sys/class/udc/musb-hdrc/device/cmode 2
    start adbd

on property:sys.usb.ffs.ready=1
    write /config/usb_gadget/g1/UDC "none"
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp_adb"
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee2
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/UDC "musb-hdrc"
    setprop sys.usb.state "mtp,adb"

on property:sys.usb.ffs.mtp.ready=1
    write /config/usb_gadget/g1/UDC "none"
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp_adb"
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee2
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/UDC "musb-hdrc"
    setprop sys.usb.state "mtp,adb"

on post-fs
    symlink /dev/block/sda /dev/block/mmcblk0boot0
    symlink /dev/block/sdb /dev/block/mmcblk0boot1
    symlink /dev/block/mmcblk0boot0 /dev/block/platform/bootdevice/by-name/preloader_a
    symlink /dev/block/mmcblk0boot1 /dev/block/platform/bootdevice/by-name/preloader_b

# Stack decrypt FDE MT6765 (ikut pola working Xiaomi cactus, SoC sama):
# hwservicemanager + servicemanager wajib jalan sebelum keymaster-3-0,
# keymaster-3-0 + teei_daemon jalan saat ro.crypto.state=encrypted,
# berhenti setelah twrp.decrypt.done=true (hemat RAM + hindari hang).
on init
    start hwservicemanager
    start servicemanager

service hwservicemanager /sbin/hwservicemanager
    user root
    group root
    disabled
    onrestart setprop hwservicemanager.ready false
    seclabel u:r:recovery:s0

service servicemanager /sbin/servicemanager
    user root
    group root
    disabled
    onrestart setprop servicemanager.ready false
    seclabel u:r:recovery:s0

service keymaster-3-0 /sbin/android.hardware.keymaster@3.0-service
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

on property:ro.crypto.state=encrypted
    start teei_daemon
    start keymaster-3-0

on property:twrp.decrypt.done=true
    stop teei_daemon
    stop keymaster-3-0

# TEE microtrust: teei_daemon WAJIB jalan sebelum decrypt FDE.
# Tanpa ini keymaster hang di kernel (proses D-state, log "Decrypt took too long")
# karena /dev/teei_client tidak ada yang serve. Di boot normal daemon ini
# di-start vendor microtrust.rc (service teei_daemon, class core, user/group system).
# CATATAN: pakai salinan /sbin/teei_daemon (blob stock yang INTERP-nya sudah
# dipatch /system/bin/linker64 -> /sbin/linker64). Stock INTERP tidak jalan di
# recovery: ramdisk tidak punya /system/bin/linker64 (linker recovery ada di
# /sbin/linker64), akibatnya execve ENOENT + crash-loop tiap 5 detik
# ("init.svc.teei_daemon=restarting", boot lambat, TEE mati, decrypt gagal).
# /vendor/bin TIDAK dipakai: ketutup mount partisi vendor stock saat boot.
service teei_daemon /sbin/teei_daemon
    class core
    user system
    group system
    disabled
    seclabel u:r:recovery:s0

on boot
    chmod 0660 /dev/teei_client
    chown system system /dev/teei_client
    chmod 0660 /dev/teei_config
    chown system system /dev/teei_config
    chmod 0660 /dev/tee0
    chown system keystore /dev/tee0
    chmod 0660 /dev/tz_vfs
    chown system system /dev/tz_vfs
    chmod 0660 /dev/teei_fp
    chown system system /dev/teei_fp
    chmod 0660 /dev/ut_keymaster
    chown system keystore /dev/ut_keymaster
    chmod 0660 /dev/rpmb0
    chown system system /dev/rpmb0
    chown system system /sys/bus/platform/devices/utos/load_ut_drv
    chown system system /sys/bus/platform/devices/utos/unload_ut_drv
    chown system system /sys/bus/platform/devices/utos/notify_ree_dci_handler
    start teei_daemon

# Auto DFE: cegah system mengenkripsi ulang /data (idempotent, aman di tiap boot).
# Script memeriksa vendor fstab.mt6765, hanya mengubah forcefdeorfbe= -> encryptable=
# kalau flag itu masih ada. Tidak pernah menggagalkan boot (exit 0 selalu).
on boot
    exec -- /sbin/dfe_patch.sh

# DT2W (NVT36xxx-ts / NT36672A, MT6765) — sesuai modul referensi
# android_device_infinix_X625D-module_dt2w (hasil investigasi via ADB):
#  - Write node = /proc/gesture_function (BUKAN /proc/gesture_state, itu read-only status).
#  - Format = TEPAT 3 char tanpa newline, contoh "cc1" = enable Double Tap
#    (dmesg: "CTP-gesture buff 0:c 1:c 2:1!!!").
#  - JANGAN tulis "cc:1" / "w:1;m:1;c:1;cc:1;" (pakai titik dua/koma) — itu bikin hang.
# Dijalankan via oneshot service (script /sbin/dt2w_enable.sh) karena node proc
# baru ada setelah driver probe (~1.8s+): `write` langsung di `on boot` bisa jalan
# SEBELUM node ada lalu gagal diam-diam tanpa retry. Service tidak block boot.
# Verifikasi: adb shell "cat /proc/gesture_state; cat /tmp/dt2w.log"
# (harusnya ada "cc:1").
service dt2w_enable /sbin/dt2w_enable.sh
    disabled
    oneshot
    seclabel u:r:recovery:s0

# Trigger saat recovery sudah running (BUKAN on boot): recovery binary men-disable
# gesture (ctp_gesture_fun_enable=0) di ~2.6 detik. Enable harus terjadi SETELAH itu,
# script sendiri masih sleep+verifikasi+tulis ulang. seclabel WAJIB ada — tanpa itu
# service tidak diregistrasi init di build ini (hasil debug: service tanpa seclabel
# tidak muncul di init.svc.* samasekali).
on property:init.svc.recovery=running
    start dt2w_enable
